# ============================================================
#  ScholarRAG configuration  —  copy to .env and fill in
# ============================================================

# ---- LLM provider (OpenAI-compatible interface) ----
# Default is Groq's FREE tier. Get a key in ~30s: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Alternatives (uncomment one block) ----
# OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# Local / custom OpenAI-compatible server (Ollama, LM Studio, vLLM):
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=llama3.2:3b

# ---- Embeddings (runs locally on CPU) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# If the best local match scores below this, the agent searches arXiv instead.
CORPUS_CONFIDENCE_THRESHOLD=0.35

# ---- Storage ----
VECTOR_BACKEND=auto        # auto | chroma | numpy
DATA_DIR=data
